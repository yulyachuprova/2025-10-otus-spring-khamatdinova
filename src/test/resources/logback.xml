<configuration>
    <appender name="LIST" class="ch.qos.logback.core.read.ListAppender">
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="LIST" />
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>
